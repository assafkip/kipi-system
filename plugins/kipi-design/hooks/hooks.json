{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dogfood_gate.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Artifact|SendUserFile|mcp__plugin_vercel_vercel__deploy_to_vercel",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/publish_gate.py\""
          }
        ]
      }
    ]
  }
}
