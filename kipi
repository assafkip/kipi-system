#!/bin/bash
set -euo pipefail

KIPI_HOME="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"

usage() {
  echo "kipi - manage your entrepreneur OS instances"
  echo ""
  echo "  kipi update          Pull latest skeleton into all projects"
  echo "  kipi update --dry    Show what would happen without changing anything"
  echo "  kipi rollback [name]  Revert the last skeleton sync (all instances, or one by name)"
  echo "  kipi new <path> <name>   Create a new project with the skeleton"
  echo "  kipi push            Push generic improvements back to skeleton (run from a project)"
  echo "  kipi dev             Launch Claude Code with all kipi plugins loaded"
  echo "  kipi check [phase]   Run validation harness (default: all phases)"
  echo "  kipi migrate <path>  Migrate instance to full kipi compliance"
  echo "  kipi migrate <path> --dry-run  Preview migration without changes"
  echo "  kipi cluster add <path> <name> <role>  Plug an instance into the KTLYST cluster"
  echo "  kipi cluster sync    Re-run all bridge writers (push latest state to all instances)"
  echo "  kipi list            Show all registered projects"
  echo ""
  echo "  kipi linear issue \"<title>\"   Open a Linear issue for work you are ABOUT to start"
  echo "  kipi linear pending           Show captured items Linear does not have yet"
  echo "  kipi linear status            Which repos have been rolled out to Linear"
  echo "  kipi linear plan --map <f> --remote <f> --out <f>   Plan creates (idempotent)"
  echo "  kipi linear create --plan <f> [--apply]   Apply a plan to live Linear (dry by default)"
  echo "  kipi linear map               Regenerate every repo's capability map"
  echo "  kipi linear overlap           Cross-repo divergence + collision report"
  echo "  kipi linear claim <ASK-n> --agent <name> --session <id>   Claim this tree BEFORE branching (exit 3 = refused)"
  echo "  kipi linear release <ASK-n> --agent <name> --session <id> Drop the claim (when the PR opens)"
  echo "  kipi linear claims            Who holds this working tree"
  echo "  kipi linear progress <ASK-n> \"<note>\" [--evidence \"...\"]  Post progress onto an issue"
  echo "  kipi review <PR#> [--post]  Adversarial PR review (Netflix staff, fresh eyes, repro-or-drop)"
  echo "  kipi jobs [--apply]  File/refresh one migration issue per scheduled job"
  echo "  kipi work [--apply]  Autonomous worker: take a ready issue, branch, PR (never merges/closes)"
  echo "  kipi dor [--apply]   Draft a Definition of Ready onto issues that lack one (bounded)"
  echo "  kipi health          Fleet health check: dark/failing jobs, double schedules, open spillover"
  echo "  kipi health --apply  ...and file each finding as a deduped Linear issue"
  echo "  kipi lessons-run     Run the daily auto-learn heartbeat once (distill->publish->propagate->slack)"
  echo "  kipi home            Print the skeleton path"
  echo ""
}

case "${1:-help}" in
  update)
    shift || true
    if [ "${1:-}" = "--dry" ]; then
      bash "$KIPI_HOME/kipi-update.sh" --dry-run
    else
      bash "$KIPI_HOME/kipi-update.sh"
    fi
    ;;
  rollback)
    shift || true
    bash "$KIPI_HOME/kipi-rollback.sh" "$@"
    ;;
  new)
    shift
    bash "$KIPI_HOME/kipi-new-instance.sh" "$@"
    ;;
  dev)
    claude --plugin-dir "$KIPI_HOME/plugins/kipi-core" \
           --plugin-dir "$KIPI_HOME/plugins/kipi-ops" \
           --plugin-dir "$KIPI_HOME/plugins/kipi-design"
    ;;
  sync-skills)
    echo "DEPRECATED: Skills are now distributed via marketplace plugins."
    echo "Instances use extraKnownMarketplaces + enabledPlugins in .claude/settings.json"
    echo "See plugins/ directory for kipi-core, kipi-ops, kipi-design"
    ;;
  push)
    bash "$KIPI_HOME/kipi-push-upstream.sh"
    ;;
  review)
    # THE review agent for every PR: Netflix senior-staff persona, fresh eyes,
    # adversarial, and every finding must ship a reproducer it actually ran.
    shift || true
    bash "$KIPI_HOME/q-system/.q-system/scripts/pr-review-agent.sh" "$@"
    ;;
  jobs)
    # One tracked Linear issue per scheduled job, for the migration onto
    # Linear-tracked execution. Idempotent on job-migration/<label>.
    shift || true
    python3 "$KIPI_HOME/q-system/.q-system/scripts/linear-job-migration.py" "$@"
    ;;
  work)
    # The autonomous worker. Dry by default; --apply to actually run an issue.
    # It opens a PR and stops: it cannot merge and cannot close an issue.
    shift || true
    bash "$KIPI_HOME/q-system/.q-system/scripts/linear-worker.sh" "$@"
    ;;
  dor)
    # Bounded nightly DoR drafter. The autonomous worker only picks up issues that
    # satisfy Definition of Ready, so this is the gate on autonomy, not paperwork.
    shift || true
    python3 "$KIPI_HOME/q-system/.q-system/scripts/linear-dor-drafter.py" "$@"
    ;;
  health)
    # Daily fleet health. Every detector must DETECT, ACT (file a deduped Linear
    # issue) and LEARN -- validate_detectors() refuses an alert-only checker.
    # Scheduled by q-system/.q-system/scripts/com.kipi.fleet-health.plist at 08:15.
    shift || true
    python3 "$KIPI_HOME/q-system/.q-system/scripts/fleet-health-daily.py" "$@"
    ;;
  linear)
    # Issue-first fast path. The commit-msg gate (linear-issue-ref-check.py)
    # refuses a commit that names no issue; this is how you cheaply get an issue
    # to name BEFORE building, rather than minting a receipt after.
    # Capture is local and offline; the Linear write happens in the agent drain,
    # because no Linear API key exists for a shell to use.
    shift || true
    QUEUE="$KIPI_HOME/q-system/.q-system/scripts/linear-queue.py"
    SYNC="$KIPI_HOME/q-system/.q-system/scripts/linear-sync.py"
    # linear-claim.py resolves the tree it locks from the CALLER's cwd, not from
    # $KIPI_HOME -- otherwise every instance would share the skeleton's lock.
    CLAIM="$KIPI_HOME/q-system/.q-system/scripts/linear-claim.py"
    sub="${1:-pending}"
    shift || true
    case "$sub" in
      issue)
        title="${1:-}"
        if [ -z "$title" ]; then
          echo "usage: kipi linear issue \"<title>\" [--note \"...\"]" >&2
          exit 1
        fi
        shift || true
        repo="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
        python3 "$QUEUE" add --repo "$repo" --kind issue --title "$title" --source kipi-cli "$@"
        echo ""
        echo "Captured. It is not in Linear yet: run /linear-drain in a Claude session."
        ;;
      pending) python3 "$QUEUE" pending "$@" ;;
      status)  python3 "$SYNC" status "$@" ;;
      map)
        # Regenerate the capability map for every registered instance + the
        # skeleton. Cheap (~25s) and the only way drift gets noticed.
        python3 - "$KIPI_HOME" <<'PY'
import json, os, subprocess, sys
home = sys.argv[1]
gen = os.path.join(home, "q-system/.q-system/scripts/capability-map-gen.py")
outdir = os.path.join(home, "q-system/output/capability-maps")
os.makedirs(outdir, exist_ok=True)
reg = json.load(open(os.path.join(home, "instance-registry.json")))["instances"]
targets = reg + [{"name": "kipi-system", "path": home}]
for i in targets:
    out = os.path.join(outdir, i["name"].replace(" ", "_") + ".json")
    r = subprocess.run(["python3", gen, "--root", i["path"], "--repo", i["name"],
                        "--out", out], capture_output=True, text=True)
    print(r.stdout.strip() or f"FAILED {i['name']}: {r.stderr.strip()[:120]}")
PY
        ;;
      overlap)
        python3 "$KIPI_HOME/q-system/.q-system/scripts/capability-overlap.py" \
          --maps "$KIPI_HOME/q-system/output/capability-maps" \
          --out "$KIPI_HOME/q-system/output/plans/capability-overlap-$(date +%F).md" \
          --digest "$KIPI_HOME/q-system/output/capability-digest.json" "$@"
        ;;
      plan)    python3 "$SYNC" plan "$@" ;;
      # Applies a plan to LIVE Linear. Dry unless --apply, because Linear
      # delete/archive are hook-blocked so a duplicate is permanent.
      create)  python3 "$SYNC" create "$@" ;;
      remote)  python3 "$SYNC" remote "$@" ;;
      # Progress belongs ON the issue: a trail the next agent can read.
      progress) python3 "$SYNC" progress "$@" ;;
      record)  python3 "$SYNC" record "$@" ;;
      key)     python3 "$SYNC" key "$@" ;;
      # Claim BEFORE creating a branch or worktree. Exit 3 means refused (another
      # session holds this tree), which is the feature, not a failure.
      claim)   python3 "$CLAIM" claim "$@" ;;
      release) python3 "$CLAIM" release "$@" ;;
      claims)  python3 "$CLAIM" status "$@" ;;
      *)
        echo "unknown: kipi linear $sub" >&2
        echo "try: issue | pending | status | map | overlap | plan | remote | create | progress | record | key" >&2
        echo "     claim | release | claims" >&2
        exit 1
        ;;
    esac
    ;;
  check)
    shift || true
    # Capability gate runs against the repo you are STANDING in, so an
    # instance gets ITS tree gated. Without this, `kipi check` cd'd to
    # KIPI_HOME and only ever validated the skeleton — an instance-side
    # silent absence had no call site at all (finding-2,
    # prd-silent-absence-capability-gate-2026-07-23).
    CALLER_DIR="$PWD"
    # Instance-ness = a q-system tree exists AT ALL. Requiring the deeper
    # .q-system path let a repo whose ENTIRE .q-system dir vanished slip
    # through as "not an instance" and silently validate the skeleton instead
    # (codex adversarial, sag-callsite) — the worse the absence, the softer
    # the failure. Broader marker, then the gate script check goes loud.
    if [ "$CALLER_DIR" != "$KIPI_HOME" ] && [ -d "$CALLER_DIR/q-system" ]; then
      if [ -f "$CALLER_DIR/q-system/.q-system/scripts/capability-gate.py" ]; then
        echo "capability gate (instance: $CALLER_DIR)"
        python3 "$CALLER_DIR/q-system/.q-system/scripts/capability-gate.py" --repo-root "$CALLER_DIR" || exit 1
      else
        # A kipi instance without the gate is itself a silent absence — the
        # exact class this gate exists for. Loud, not skipped.
        echo "RED: capability-gate.py MISSING in $CALLER_DIR (run kipi update)" >&2
        exit 1
      fi
      # The instance suite just ran in full; skip the skeleton's own gate so a
      # from-instance check does not execute two full suites (codex finding,
      # sag-callsite). Skeleton-run `kipi check` still gates the skeleton.
      cd "$KIPI_HOME"
      CAPABILITY_GATE_SKIP=1 KIPI_GATE_SKIP_CALLER=kipi-check-instance python3 validate-separation.py "${1:-5}"
    else
      cd "$KIPI_HOME"
      python3 validate-separation.py "${1:-5}"
    fi
    ;;
  migrate)
    shift
    python3 "$KIPI_HOME/kipi-migrate.py" "$@"
    ;;
  cluster)
    shift
    case "${1:-}" in
      add)
        shift
        python3 "$KIPI_HOME/kipi-cluster-add.py" "$@"
        ;;
      sync)
        echo "Syncing KTLYST cluster bridge..."
        python3 "$HOME/.ktlyst/bridge/bridge-sync.py" 2>&1
        python3 "$HOME/.ktlyst/bridge/write-legal-flags.py" 2>&1
        python3 "$HOME/.ktlyst/bridge/write-website-state.py" 2>&1
        echo "Done. All bridge files updated."
        ;;
      *)
        echo "Usage:"
        echo "  kipi cluster add <path> <name> <role>"
        echo "  kipi cluster sync"
        ;;
    esac
    ;;
  list)
    python3 -c "
import json
d = json.load(open('$KIPI_HOME/instance-registry.json'))
print('Registered projects:')
for i in d['instances']:
    t = i.get('type', 'subtree')
    print(f\"  {i['name']:20s} {t:15s} {i['path']}\")
if d.get('excluded'):
    print()
    print('Excluded (different architecture):')
    for e in d['excluded']:
        print(f\"  {e['name']:20s} {e.get('reason', '')}\")
"
    ;;
  lessons-run)
    shift || true
    bash "$KIPI_HOME/q-system/.q-system/scripts/lessons-daily.sh" "$@"
    ;;
  home)
    echo "$KIPI_HOME"
    ;;
  help|--help|-h|*)
    usage
    ;;
esac
