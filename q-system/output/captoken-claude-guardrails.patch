@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# test-capability-approval.sh — unit tests for the capability approval token
+# (full/capability-token.sh) and the approve-gate hook (full/approve-gate.sh).
+#
+# Safe: runs entirely inside a throwaway CLAUDE_GUARDRAILS_DIR and never touches
+# a real ~/.claude. Uses openssl only (no Secure Enclave required).
+set -euo pipefail
+
+REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
+TOKEN="$REPO_DIR/full/capability-token.sh"
+GATE="$REPO_DIR/full/approve-gate.sh"
+
+CLAUDE_GUARDRAILS_DIR="$(mktemp -d -t cg-captoken-test.XXXXXX)"
+export CLAUDE_GUARDRAILS_DIR
+cleanup() { rm -rf "$CLAUDE_GUARDRAILS_DIR"; }
+trap cleanup EXIT
+
+PASS=0; FAIL=0
+expect() { # <actual> <want> <label>
+  if [ "$1" = "$2" ]; then echo "  ok   $3"; PASS=$((PASS+1));
+  else echo "  FAIL $3 (got=$1 want=$2)"; FAIL=$((FAIL+1)); fi
+}
+run()  { bash "$TOKEN" "$@" >/dev/null 2>&1; echo $?; }
+gate() { printf '{"tool_input":{"command":"%s"},"cwd":"/w"}' "$1" | bash "$GATE" >/dev/null 2>&1; echo $?; }
+
+echo "capability-token core:"
+expect "$(run keygen)" 0 "keygen creates a keypair"
+expect "$(run approve 'CMD-A' /w)" 0 "approve mints a token"
+expect "$(run check 'CMD-A' /w)" 0 "valid token allows once"
+expect "$(run check 'CMD-A' /w)" 1 "token is single-use"
+run approve 'CMD-A' /w >/dev/null 2>&1
+expect "$(run check 'CMD-B' /w)" 1 "token is command-scoped"
+expect "$(run check 'NEVER' /w)" 1 "cold check denies"
+CLAUDE_GUARDRAILS_TTL=0 bash "$TOKEN" approve 'CMD-X' /w >/dev/null 2>&1
+expect "$(run check 'CMD-X' /w)" 1 "expired token denies"
+
+echo "approve-gate hook:"
+expect "$(gate 'ls -la')" 0 "benign command ignored"
+expect "$(gate 'git push origin main')" 2 "destructive blocked without token"
+run approve 'git push origin main' /w >/dev/null 2>&1
+expect "$(gate 'git push origin main')" 0 "destructive allowed with token"
+expect "$(gate 'git push origin main')" 2 "destructive single-use enforced"
+expect "$(printf 'not json' | bash "$GATE" >/dev/null 2>&1; echo $?)" 0 "malformed JSON fails open"
+
+echo ""
+echo "RESULT: $PASS passed, $FAIL failed"
+[ "$FAIL" -eq 0 ]
