index 0000000..1eb09f8
--- /dev/null
+++ b/full/capability-token.sh
@@ -0,0 +1,172 @@
+#!/usr/bin/env bash
+# capability-token.sh — forgery-resistant, command-scoped, single-use approval
+# tokens for claude-guardrails.
+#
+# claude-guardrails blocks destructive commands (exit 2) with no safe way to
+# approve one. This adds that path: a human mints a one-time token bound to an
+# exact command; the approve-gate hook honors a destructive command only if it
+# carries a valid signature over that command from the trusted key. An agent
+# that merely writes a token file cannot forge a valid signature.
+#
+# Forgery resistance:
+#   - default (openssl): the private key is a 0600 file. claude-guardrails' own
+#     "Read **/*.key" deny rule keeps the agent from reading it, so it cannot
+#     sign. Strong, not hardware-rooted.
+#   - optional: set CAPABILITY_SIGNER to a Secure Enclave / Touch ID signer
+#     (reads payload on stdin, emits base64 signature) for non-exportable keys.
+#
+# Subcommands: keygen | approve <cmd> [cwd] | hash <cmd> [cwd] | mint <hash> | check <cmd> [cwd]
+# Everything fails closed. There is no downgrade to unsigned acceptance.
+
+set -uo pipefail
+
+# Pin PATH so security-critical externals (openssl, mv, sed, base64) cannot be
+# hijacked via a caller-controlled PATH.
+export PATH=/usr/bin:/bin:/usr/sbin:/sbin
+
+GUARD_DIR="${CLAUDE_GUARDRAILS_DIR:-$HOME/.claude/guardrails}"
+APPROVALS_DIR="${CLAUDE_GUARDRAILS_APPROVALS:-$GUARD_DIR/approvals}"
+PRIVKEY="${CLAUDE_GUARDRAILS_PRIVKEY:-$GUARD_DIR/capability-token.key}"
+PUBKEY="${CLAUDE_GUARDRAILS_PUBKEY:-$GUARD_DIR/capability-token.pub}"
+AUDIT_LOG="${CLAUDE_GUARDRAILS_LOG:-$GUARD_DIR/audit.log}"
+TTL="${CLAUDE_GUARDRAILS_TTL:-300}"
+# Override to use a hardware signer instead of the openssl default.
+SIGNER="${CAPABILITY_SIGNER:-}"
+
+_sha256() {
+  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
+  else shasum -a 256 | awk '{print $1}'; fi
+}
+_now() { date +%s; }
+
+_log() {
+  local event="$1" hash="$2" detail="$3" ts
+  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  { mkdir -p "$(dirname "$AUDIT_LOG")" 2>/dev/null \
+      && printf '{"ts":"%s","event":"%s","hash":"%s","detail":"%s"}\n' \
+         "$ts" "$event" "$hash" "$detail" >> "$AUDIT_LOG"; } 2>/dev/null || true
+}
+
+# Domain-separated, versioned payload. Binding the version + both fields
+# prevents cross-protocol signature reuse.
+_payload() { printf 'claude-guardrails-capability.v1\n%s\n%s' "$1" "$2"; }  # hash, expiry
+
+_sign() {
+  # stdin: payload bytes. stdout: base64 signature. openssl default, or the
+  # configured hardware signer.
+  if [ -n "$SIGNER" ]; then
+    # shellcheck disable=SC2086 -- SIGNER is a trusted command line.
+    $SIGNER
+    return
+  fi
+  [ -r "$PRIVKEY" ] || { echo "sign: no readable private key at $PRIVKEY (run: keygen)" >&2; return 1; }
+  openssl dgst -sha256 -sign "$PRIVKEY" | openssl base64 -A
+}
+
+cmd_keygen() {
+  mkdir -p "$GUARD_DIR" || { echo "keygen: cannot create $GUARD_DIR" >&2; return 1; }
+  chmod 0700 "$GUARD_DIR" 2>/dev/null || true
+  if [ -f "$PRIVKEY" ]; then
+    echo "keygen: key already exists at $PRIVKEY (leaving as-is)"
+    return 0
+  fi
+  ( umask 077; openssl ecparam -genkey -name prime256v1 -noout -out "$PRIVKEY" 2>/dev/null ) \
+    || { echo "keygen: private key generation failed" >&2; return 1; }
+  chmod 0600 "$PRIVKEY"
+  openssl ec -in "$PRIVKEY" -pubout -out "$PUBKEY" 2>/dev/null \
+    || { echo "keygen: public key export failed" >&2; return 1; }
+  echo "keygen: created $PRIVKEY (keep it unreadable by agents) and $PUBKEY"
+}
+
+cmd_hash() {
+  # hash(sha256(command) : sha256(cwd)) -> single 64-hex id.
+  local command="${1-}" cwd="${2-}" hc hd
+  hc="$(printf '%s' "$command" | _sha256)" || return 1
+  hd="$(printf '%s' "$cwd" | _sha256)" || return 1
+  printf '%s:%s' "$hc" "$hd" | _sha256
+}
+
+cmd_mint() {
+  # mint <hash>: sign the v1 payload, write a two-line token (expiry, sig-b64).
+  local hash="${1-}"
+  case "$hash" in ''|*[!0-9a-f]*) echo "mint: hash must be 64 lowercase hex chars" >&2; return 2 ;; esac
+  [ "${#hash}" -eq 64 ] || { echo "mint: hash must be 64 lowercase hex chars" >&2; return 2; }
+  mkdir -p "$APPROVALS_DIR" 2>/dev/null || { echo "mint: cannot create $APPROVALS_DIR" >&2; return 1; }
+  chmod 0700 "$APPROVALS_DIR" 2>/dev/null || true
+  _prune_expired
+  local now expiry payload sig tmp
+  now="$(_now)"
+  expiry=$(( now + TTL ))
+  payload="$(_payload "$hash" "$expiry")"
+  sig="$(printf '%s' "$payload" | _sign)" || { echo "mint: signing failed" >&2; return 1; }
+  [ -n "$sig" ] || { echo "mint: signer produced no signature" >&2; return 1; }
+  tmp="$APPROVALS_DIR/$hash.token.minting.$$"
+  printf '%s\n%s\n' "$expiry" "$sig" > "$tmp" || { echo "mint: write failed" >&2; return 1; }
+  mv "$tmp" "$APPROVALS_DIR/$hash.token" || { rm -f "$tmp" 2>/dev/null || true; echo "mint: install failed" >&2; return 1; }
+  _log grant "$hash" "$expiry"
+  echo "approved one command (hash ${hash:0:12}...), expires in ${TTL}s"
+}
+
+cmd_approve() {
+  # approve <command> [cwd]: hash then mint. The human-facing entry point.
+  local command="${1-}" cwd="${2-$PWD}" hash
+  [ -n "$command" ] || { echo "approve: usage: approve <command> [cwd]" >&2; return 2; }
+  hash="$(cmd_hash "$command" "$cwd")" || return 1
+  cmd_mint "$hash"
+}
+
+cmd_check() {
+  # check <command> [cwd]: exit 0 iff a token exists whose signature over the
+  # v1 payload verifies against the trusted pubkey AND is unexpired. Atomically
+  # claim first (single winner), then verify before allowing.
+  local command="${1-}" cwd="${2-$PWD}"
+  local hash tokenfile claim expiry sig payload now sigder payfile rc
+  hash="$(cmd_hash "$command" "$cwd")" || return 1
+  tokenfile="$APPROVALS_DIR/$hash.token"
+  claim="$tokenfile.consuming.$$"
+  mv "$tokenfile" "$claim" 2>/dev/null || return 1     # atomic single-use claim
+  expiry="$(sed -n '1p' "$claim" 2>/dev/null)"
+  sig="$(sed -n '2p' "$claim" 2>/dev/null)"
+  rm -f "$claim" 2>/dev/null || true
+  case "$expiry" in ''|*[!0-9]*) _log consume "$hash" malformed; return 1 ;; esac
+  [ -n "$sig" ] || { _log consume "$hash" no-sig; return 1; }
+  [ -r "$PUBKEY" ] || { _log consume "$hash" no-pubkey; return 1; }   # no downgrade
+  payload="$(_payload "$hash" "$expiry")"
+  sigder="$(mktemp)" || return 1
+  payfile="$(mktemp)" || { rm -f "$sigder"; return 1; }
+  printf '%s' "$sig" | openssl base64 -d -A > "$sigder" 2>/dev/null
+  printf '%s' "$payload" > "$payfile"
+  openssl dgst -sha256 -verify "$PUBKEY" -signature "$sigder" "$payfile" >/dev/null 2>&1
+  rc=$?
+  rm -f "$sigder" "$payfile" 2>/dev/null || true
+  if [ "$rc" -ne 0 ]; then _log consume "$hash" bad-sig; return 1; fi
+  now="$(_now)"
+  if [ "$expiry" -gt "$now" ]; then _log consume "$hash" "allowed:$expiry"; return 0; fi
+  _log consume "$hash" "expired:$expiry"
+  return 1
+}
+
+_prune_expired() {
+  local f exp now
+  now="$(_now)"
+  for f in "$APPROVALS_DIR"/*.token; do
+    [ -e "$f" ] || continue
+    exp="$(sed -n '1p' "$f" 2>/dev/null)"
+    case "$exp" in ''|*[!0-9]*) rm -f "$f" 2>/dev/null || true; continue ;; esac
+    [ "$exp" -gt "$now" ] || rm -f "$f" 2>/dev/null || true
+  done
+}
+
+main() {
+  local sub="${1-}"; shift 2>/dev/null || true
+  case "$sub" in
+    keygen)  cmd_keygen ;;
+    hash)    cmd_hash "${1-}" "${2-}" ;;
+    mint)    cmd_mint "${1-}" ;;
+    approve) cmd_approve "${1-}" "${2-}" ;;
+    check)   cmd_check "${1-}" "${2-}" ;;
+    *) echo "usage: capability-token.sh {keygen|approve <cmd> [cwd]|hash <cmd> [cwd]|mint <hash>|check <cmd> [cwd]}" >&2; return 2 ;;
+  esac
+}
+
+main "$@"
