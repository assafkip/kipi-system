+#!/bin/bash
+# spex-closeout-gate.sh - Deterministic completion gate for cc-spex.
+#
+# cc-spex already states the rule but enforces it only as a prompt the
+# agent can skip in autonomous mode:
+#   - verify.md: "Claiming work is complete without verification is
+#     dishonesty, not efficiency. Evidence before claims, always."
+#   - review-code.md: "DO NOT proceed with deviations unresolved."
+#   - deep-review run.md: flow state advances "even if findings remain."
+# This script makes that rule a gate. It reads the deep-review findings
+# table and refuses completion while Critical or Important findings are
+# unresolved.
+#
+# Source of truth: specs/<feature>/review-findings.md (written by the
+# spex-deep-review extension), whose summary table carries a Remaining
+# column. The project's own rule is "Critical + Important = 0 => GATE
+# PASS"; this enforces it.
+#
+# Behavior (acceptance-friendly):
+#   - no review-findings.md      => pass (exit 0); does not force review
+#   - unparseable Remaining cells => pass + warn, unless
+#                                    SPEX_CLOSEOUT_STRICT=1 (then block)
+#   - Critical+Important Remaining > 0 => block (exit 1) with the counts
+#
+# Usage: spex-closeout-gate.sh [--spec-dir <dir>]
+# Run from the project root.
+
+set -euo pipefail
+
+STATE_FILE="${SHIP_STATE_FILE:-.specify/.spex-state}"
+STRICT="${SPEX_CLOSEOUT_STRICT:-0}"
+
+resolve_spec_dir() {
+  local spec_dir="$1"
+  if [ -n "$spec_dir" ]; then
+    printf '%s\n' "$spec_dir"
+    return
+  fi
+  if [ -f "$STATE_FILE" ]; then
+    spec_dir="$(jq -r '.spec_dir // empty' "$STATE_FILE" 2>/dev/null || true)"
+  fi
+  if [ -z "$spec_dir" ]; then
+    local branch
+    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
+    spec_dir="specs/$branch"
+  fi
+  printf '%s\n' "$spec_dir"
+}
+
+# Pull the Remaining count for one severity row out of the markdown table.
+# Row shape: | Critical | <found> | <fixed> | <remaining> |
+# Remaining is the 4th data cell ($5 when splitting on '|'). Returns the
+# integer, or "X" when the cell is missing/non-numeric.
+remaining_for() {
+  local severity="$1" file="$2" row cell
+  # `|| true` so a no-match grep does not trip set -e under pipefail.
+  row="$(grep -iE "^\|[[:space:]]*\*{0,2}${severity}\*{0,2}[[:space:]]*\|" "$file" 2>/dev/null | head -1 || true)"
+  if [ -z "$row" ]; then
+    printf 'X\n'
+    return 0
+  fi
+  cell="$(printf '%s\n' "$row" | awk -F'|' '{ gsub(/[^0-9]/, "", $5); print $5 }')"
+  if [ -z "$cell" ]; then
+    printf 'X\n'
+  else
+    printf '%s\n' "$cell"
+  fi
+}
+
+main() {
+  local spec_dir_arg=""
+  while [ $# -gt 0 ]; do
+    case "$1" in
+      --spec-dir) shift; spec_dir_arg="${1:-}" ;;
+      *) ;;
+    esac
+    shift || true
+  done
+
+  local spec_dir findings
+  spec_dir="$(resolve_spec_dir "$spec_dir_arg")"
+  findings="$spec_dir/review-findings.md"
+
+  if [ ! -f "$findings" ]; then
+    echo "closeout-gate: no review-findings.md at $findings; nothing to gate (pass)." >&2
+    exit 0
+  fi
+
+  local crit imp
+  crit="$(remaining_for Critical "$findings")"
+  imp="$(remaining_for Important "$findings")"
+
+  if [ "$crit" = "X" ] || [ "$imp" = "X" ]; then
+    if [ "$STRICT" = "1" ]; then
+      echo "closeout-gate: cannot parse Remaining counts in $findings (strict => block)." >&2
+      exit 1
+    fi
+    echo "closeout-gate: cannot parse Remaining counts in $findings; passing (set SPEX_CLOSEOUT_STRICT=1 to block)." >&2
+    exit 0
+  fi
+
+  local total=$(( crit + imp ))
+  if [ "$total" -gt 0 ]; then
+    echo "closeout-gate: BLOCKED. ${crit} Critical + ${imp} Important finding(s) unresolved in ${findings}." >&2
+    echo "Resolve them or re-run deep review before claiming completion." >&2
+    echo "cc-spex: 'Evidence before claims, always.'" >&2
+    exit 1
+  fi
+
+  echo "closeout-gate: pass (0 Critical/Important remaining in ${findings})."
+  exit 0
+}
+
+main "$@"
diff --git a/tests/test_closeout_gate.sh b/tests/test_closeout_gate.sh
new file mode 100755
index 0000000..3c7d08a
--- /dev/null
+++ b/tests/test_closeout_gate.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+# Unit test: verify the closeout gate refuses completion while deep review
+# left unresolved Critical/Important findings, and passes otherwise.
+#
+# Usage:
+#   ./tests/test_closeout_gate.sh
+#
+# What it checks:
+#   1. Remaining Critical/Important > 0  -> blocks (exit 1)
+#   2. All Remaining = 0                 -> passes (exit 0)
+#   3. Important-only Remaining > 0      -> blocks (exit 1)
+#   4. No review-findings.md             -> passes (exit 0, does not force review)
+#   5. Unparseable table (default)       -> passes (exit 0, never a false block)
+#   6. Unparseable table (strict)        -> blocks (exit 1)
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(dirname "$SCRIPT_DIR")"
+GATE="$REPO_ROOT/spex/scripts/spex-closeout-gate.sh"
+
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+NC='\033[0m'
+PASSED=0
+FAILED=0
+
+pass() { echo -e "  ${GREEN}✓${NC} $1"; PASSED=$((PASSED + 1)); }
+fail() { echo -e "  ${RED}✗${NC} $1"; FAILED=$((FAILED + 1)); }
+
+# run_gate <workdir> <spec-dir> [extra env assignment] -> echoes exit code
+run_gate() {
+  local workdir="$1" spec="$2" env_kv="${3:-}"
+  local rc=0
+  if [ -n "$env_kv" ]; then
+    ( cd "$workdir" && env "$env_kv" bash "$GATE" --spec-dir "$spec" ) >/dev/null 2>&1 || rc=$?
+  else
+    ( cd "$workdir" && bash "$GATE" --spec-dir "$spec" ) >/dev/null 2>&1 || rc=$?
+  fi
+  echo "$rc"
+}
+
+assert_exit() { # <label> <actual> <want>
+  if [ "$2" = "$3" ]; then pass "$1 (exit=$2)"; else fail "$1 (exit=$2 want=$3)"; fi
+}
+
+WORK="$(mktemp -d)"
+mkdir -p "$WORK/specs/has-findings" "$WORK/specs/no-findings"
+
+write_findings() { # <crit-remaining> <imp-remaining>
+  cat > "$WORK/specs/has-findings/review-findings.md" <<EOF
+| Severity  | Found | Fixed | Remaining |
+| Critical  | 5     | 0     | $1        |
+| Important | 5     | 0     | $2        |
+| Minor     | 1     | -     | 1         |
+EOF
+}
+
+echo "Closeout gate tests:"
+
+write_findings 1 0
+assert_exit "remaining Critical>0 blocks" "$(run_gate "$WORK" specs/has-findings)" 1
+
+write_findings 0 0
+assert_exit "all remaining 0 passes" "$(run_gate "$WORK" specs/has-findings)" 0
+
+write_findings 0 2
+assert_exit "important-only remaining blocks" "$(run_gate "$WORK" specs/has-findings)" 1
+
+assert_exit "no findings file passes" "$(run_gate "$WORK" specs/no-findings)" 0
+
+printf 'not a findings table\n' > "$WORK/specs/has-findings/review-findings.md"
+assert_exit "unparseable default passes" "$(run_gate "$WORK" specs/has-findings)" 0
+assert_exit "unparseable strict blocks" "$(run_gate "$WORK" specs/has-findings SPEX_CLOSEOUT_STRICT=1)" 1
+
+echo ""
+echo "Result: ${PASSED} passed, ${FAILED} failed"
+[ "$FAILED" -eq 0 ]
