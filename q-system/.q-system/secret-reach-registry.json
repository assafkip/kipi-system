{
  "_comment": "Read by q-system/.q-system/scripts/secret-reach-inventory.py (ASK-1251). One row per secret a session running as the founder's uid can reach. class: authority = possession lets the process send, write, delete, publish or spend; knowledge = possession only reveals information. Every authority row names a decision in q-system/canonical/decisions.md that must carry an origin tag and name the row id in backticks. Paths only, never values.",
  "scan_dirs": ["~/.config/kipi"],
  "shell_files": ["~/.zshrc", "~/.zprofile", "~/.zshenv", "~/.bashrc", "~/.bash_profile", "~/.profile"],
  "secret_name_re": "(?i)(token|key|secret|password|passwd|credential|webhook|proof|cookie)",
  "rows": [
    {"id": "ask-crm-local-proof", "kind": "file", "path": "~/.config/kipi/ask-crm-local-proof", "class": "authority", "grants": "presence lets the consulting CRM send real Gmail", "decision": "RULE-2026-09-13-A"},
    {"id": "kipi-linear-api-key", "kind": "file", "path": "~/.config/kipi/linear-api-key", "class": "authority", "grants": "write access to the Linear board", "decision": "RULE-2026-09-13-B"},
    {"id": "claude-credentials", "kind": "file", "path": "~/.claude/.credentials.json", "class": "authority", "grants": "runs Claude sessions billed to the account", "decision": "RULE-2026-09-13-B"},
    {"id": "gh-hosts", "kind": "file", "path": "~/.config/gh/hosts.yml", "class": "authority", "grants": "GitHub push, PR and merge as the founder", "decision": "RULE-2026-09-13-B"},
    {"id": "git-credentials", "kind": "file", "path": "~/.git-credentials", "class": "authority", "grants": "git push over https", "decision": "RULE-2026-09-13-B"},
    {"id": "netrc", "kind": "file", "path": "~/.netrc", "class": "authority", "grants": "whatever hosts it names, usually write", "decision": "RULE-2026-09-13-B"},
    {"id": "npmrc", "kind": "file", "path": "~/.npmrc", "class": "authority", "grants": "npm publish", "decision": "RULE-2026-09-13-B"},
    {"id": "aws-credentials", "kind": "file", "path": "~/.aws/credentials", "class": "authority", "grants": "AWS API as the configured identity", "decision": "RULE-2026-09-13-B"},
    {"id": "docker-config", "kind": "file", "path": "~/.docker/config.json", "class": "authority", "grants": "registry push", "decision": "RULE-2026-09-13-B"},
    {"id": "ssh-id-ed25519", "kind": "file", "path": "~/.ssh/id_ed25519", "class": "authority", "grants": "ssh and git push to every host that trusts the key", "decision": "RULE-2026-09-13-B"},
    {"id": "ssh-id-rsa", "kind": "file", "path": "~/.ssh/id_rsa", "class": "authority", "grants": "ssh and git push to every host that trusts the key", "decision": "RULE-2026-09-13-B"},
    {"id": "capability-token-pub", "kind": "file", "path": "~/.claude/capability-token.pub", "class": "knowledge", "grants": "nothing: a public key only verifies signatures"},
    {"id": "APIFY_TOKEN", "kind": "env", "class": "authority", "grants": "runs billed Apify actors", "decision": "RULE-2026-09-13-B"},
    {"id": "CLAUDE_CODE_MESSAGING_TOKEN", "kind": "env", "class": "authority", "grants": "the harness's own inter-session messaging", "decision": "RULE-2026-09-13-B"},
    {"id": "ELEVENLABS_API_KEY", "kind": "env", "class": "authority", "grants": "spends ElevenLabs credits", "decision": "RULE-2026-09-13-B"},
    {"id": "NOTION_TOKEN", "kind": "env", "class": "authority", "grants": "writes Notion pages the integration can see", "decision": "RULE-2026-09-13-B"},
    {"id": "NOTION_TOKEN_ASK", "kind": "env", "class": "authority", "grants": "writes Notion pages the ASK integration can see", "decision": "RULE-2026-09-13-B"},
    {"id": "PERPLEXITY_API_KEY", "kind": "env", "class": "authority", "grants": "spends Perplexity credits", "decision": "RULE-2026-09-13-B"},
    {"id": "POSTHOG_API_KEY", "kind": "env", "class": "authority", "grants": "unknown key type from the name alone; a personal key writes, so treated as authority", "decision": "RULE-2026-09-13-B"},
    {"id": "VIRUSTOTAL_API_KEY", "kind": "env", "class": "authority", "grants": "file submission, which shares the file with VirusTotal", "decision": "RULE-2026-09-13-B"},
    {"id": "WHOISXML_API_KEY", "kind": "env", "class": "authority", "grants": "spends WhoisXML credits", "decision": "RULE-2026-09-13-B"}
  ]
}
