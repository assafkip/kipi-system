    {"id": "ssh-id-rsa", "kind": "file", "path": "~/.ssh/id_rsa", "class": "authority", "grants": "ssh and git push to every host that trusts the key", "decision": "RULE-2026-09-13-B"},
    {"id": "capability-token-pub", "kind": "file", "path": "~/.claude/capability-token.pub", "class": "knowledge", "grants": "nothing: a public key only verifies signatures"},
