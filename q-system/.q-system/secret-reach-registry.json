    {"id": "slack-webhook-retired-2026-08-19", "kind": "file", "path": "~/.config/kipi/slack-webhook.retired-2026-08-19", "class": "authority", "grants": "posts to one Slack channel while the retired webhook stays live", "decision": "RULE-2026-09-13-C"},
    {"id": "voice-gate-key", "kind": "file", "path": "~/.config/kipi/voice-gate.key", "class": "authority", "grants": "no reader found in kipi-system; a key that signs a gate receipt can mint one, so treated as authority", "decision": "RULE-2026-09-13-C"},
    {"id": "browser-profiles", "kind": "file", "glob": "~/.config/kipi/browser-profiles/*", "class": "authority", "grants": "Chromium profiles; a logged-in one acts on its site as the founder", "decision": "RULE-2026-09-13-C"},
    {"id": "linkedin-profile", "kind": "file", "glob": "~/.config/kipi/linkedin-profile/*", "class": "authority", "grants": "logged-in LinkedIn session: posts and messages as the founder", "decision": "RULE-2026-09-13-C"},
    {"id": "reddit-profile", "kind": "file", "glob": "~/.config/kipi/reddit-profile/*", "class": "authority", "grants": "logged-in Reddit session: posts and comments as the founder", "decision": "RULE-2026-09-13-C"},
