<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly blocked:capability re-test and route (ASK-3960).
     TEMPLATE, not a loadable plist: __KIPI_REPO__ and __HOME__ are materialized by
     install-plist.sh. Pinned (job-checkouts.json), so it runs from its own tree at
     origin/main, never from the shared checkout.

     04:20, before cap-ladder.py (04:40): a block this job hands to the ladder as a
     capout is climbed the same night. A probe that passes clears its label; a
     block with no probe takes its route by capability kind at day 14. A nonzero
     exit (2: Linear refused an unblock) is what launchd-health reads.
     No double hyphen in this comment: XML forbids one there. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kipi.capability-expiry</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>cd __KIPI_REPO__ &amp;&amp; python3 q-system/.q-system/scripts/capability_block_expiry.py --dispatch-targets --apply</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>20</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.config/kipi/capability-expiry.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/kipi/capability-expiry.err</string>
</dict>
</plist>
