+json.dump([{
+    "id": "u-940", "identifier": "ASK-940", "title": "ASK-940",
+    # redrafts=3 -> the cap is spent, so this takes the terminal path.
+    "description": ("Founder context above.\n\n<!-- kipi-dor: redrafts=3 -->\n"
