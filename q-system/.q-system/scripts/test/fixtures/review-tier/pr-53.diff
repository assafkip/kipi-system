+echo "== case 6: a redraft outranks the no-DoR backlog, so it is reachable at all =="
+reset
+python3 - "$WORK/board.json" "$FOUNDER_TEXT" "$BAD_DOR" <<'PY'
+import json, sys
+path, founder, dor = sys.argv[1:4]
+board = [{
+    "id": "u-9%d" % n, "identifier": "ASK-9%d" % n, "title": "ASK-9%d" % n,
