+: > "$WORK/updates.jsonl"; : > "$WORK/calls.log"
+run_drafter --limit 5 --apply
+if [ -s "$WORK/updates.jsonl" ] || [ -s "$WORK/calls.log" ]; then
+  bad "past the cap the issue stops costing anything" \
+      "still wrote or called: $(tr '\n' ' ' < "$WORK/calls.log")"
+else
